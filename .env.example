# ModeloCFO — variables de entorno
# Copia este archivo a .env.local y rellena los valores reales.
# .env.local está en .gitignore: NUNCA se commitea.

# ── Supabase (Dashboard → Project Settings → API) ──────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Solo server-side (scripts de seed; lo usará AG02).
# JAMÁS exponer al cliente ni commitear su valor real.
# SUPABASE_SERVICE_ROLE_KEY=

# ── LLM: endpoint compatible con la API de OpenAI ──────────────────────────
# Fase 1 — modelo provisional:
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-tu-clave
LLM_MODEL=gpt-4o-mini

# Fase 2 — andgcore oracle en Modal vLLM (ver docs/MODAL_DEPLOY.md):
# LLM_BASE_URL=https://tu-deployment.modal.run/v1
# LLM_API_KEY=token-del-endpoint
# LLM_MODEL=andgcore-oracle

# ── Rate limiting (AG03) ────────────────────────────────────────────────────
# Sin infraestructura nueva: se cuenta sobre Postgres (mensajes/documentos).
# Máximo de mensajes de chat por usuario y hora (60 min móviles). Default: 40.
RATE_LIMIT_PER_HOUR=40
# Máximo de documentos ingeridos por usuario y día (24 h móviles). Default: 10.
RATE_LIMIT_UPLOADS_DAY=10
